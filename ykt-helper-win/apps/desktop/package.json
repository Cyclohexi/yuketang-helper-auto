{
  "name": "@ykt/desktop",
  "version": "2.2.1",
  "private": true,
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build": "vue-tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.node.json && npm run build:main && npm run build:preload && vite build",
    "build:main": "tsup --config tsup.main.config.ts",
    "build:preload": "tsup --config tsup.preload.config.ts",
    "start": "electron . --",
    "dev": "vite"
  },
  "dependencies": {
    "@ykt/backend": "2.2.1",
    "@ykt/contracts": "2.2.1",
    "@ykt/routing": "2.2.1",
    "@ykt/storage": "2.2.1",
    "acorn": "^8.18.0",
    "vue": "^3.5.20"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "tsup": "^8.5.0"
  }
}
